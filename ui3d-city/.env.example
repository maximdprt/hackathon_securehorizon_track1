# Copy to .env.local (never committed) and fill with the values in CLAUDE.md 11.3 / 11.4 / 11.7.
# Without NEXT_PUBLIC_SENTINEL_API the screens run on the local simulation.

# The team's API (main: api/server.py): /cars, /rpc, /avaguard/events
NEXT_PUBLIC_SENTINEL_API=https://<api-host>
# SentinelScan explorer, for tx / block / address links
NEXT_PUBLIC_EXPLORER_URL=https://<explorer-host>
# AuthorityRegistry on SentinelL1
NEXT_PUBLIC_REGISTRY_ADDRESS=0x...

# Live cars in the 3D city (open with ?live=1): the verdict stream and the chain's proofs
NEXT_PUBLIC_AVAGUARD_SSE_URL=https://<api-host>/avaguard/events
NEXT_PUBLIC_RPC_URL=https://<api-host>/rpc
NEXT_PUBLIC_CHAIN=l1
NEXT_PUBLIC_L1_CHAIN_ID=99999
