# SentinelScan frontend (SvelteKit). $env/static/* = present at BUILD time.
EXPLORER_API_URL=http://127.0.0.1:3002
DB_STRING=mongodb://127.0.0.1:27017
DB_NAME=sentinel_explorer

PUBLIC_RPC_URL=https://rpc.petroi.fr/rpc
PUBLIC_GAS_UNIT=gwei
PUBLIC_NATIVE_SYMBOL=SEC
PUBLIC_CHAIN_NAME=SentinelL1
PUBLIC_CHAIN_ID=99999
PUBLIC_CHAIN_BLOCK_TIME=2
PUBLIC_CHAIN_GAS_LIMIT=12000000
PUBLIC_CHAIN_BASE_FEE=25

# spotlight / resource links
PUBLIC_LINK_SITE=https://rpc.petroi.fr
PUBLIC_LINK_DOCS=https://rpc.petroi.fr/health
PUBLIC_LINK_RPC=https://rpc.petroi.fr/rpc
PUBLIC_LINK_SUBNET=https://explorer.petroi.fr
PUBLIC_LINK_FUJI=https://subnets-test.avax.network/
PUBLIC_LINK_CONTRACTS=https://explorer.petroi.fr
PUBLIC_LINK_GITHUB=https://github.com/maximdprt/hackathon_securehorizon_track1
PUBLIC_LINK_REPO=https://github.com/maximdprt/hackathon_securehorizon_track1

PUBLIC_SOURCIFY_VERIFY_URL=https://sourcify.dev/server
