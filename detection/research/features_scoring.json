{
 "$comment": "Features d'entree pour le scoring anti-fraude des paiements d'agents IA (voir taxonomie.md section 3). Combinaison noisy-OR : risk = 1 - prod(1 - w_i) sur les signaux presents ; toute regle hard_block force risk=1.0. Seuils : <0.30 allow, 0.30-0.70 needs_approval, >=0.70 block ; au-dessus de 50% du plafond : needs_approval des 0.20 et block des 0.60. Poids et seuils = point de depart a calibrer sur les scenarios red-team.",
 "decision_thresholds": {
  "allow_below": 0.3,
  "block_at_or_above": 0.7,
  "high_amount_adjustment": {
   "when": "amount > 50% of mandate limit",
   "allow_below": 0.2,
   "block_at_or_above": 0.6
  }
 },
