# Copy to .env and fill only what you use. Every value is optional: with none, the scripted agent runs offline.

# Agent LLM (pick one, or none for the scripted agent)
ANTHROPIC_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Sentinel guard, connected mode (default API: https://rpc.petroi.fr)
SENTINEL_API=
SENTINEL_API_KEY=

# Optional LLM inside the guard: off | anthropic | bedrock
SENTINEL_LLM=
