{
  "name": "sentinel-auth-widget",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.app.config.ts && vite build -c vite.ops.config.ts",
    "copy": "node -e \"const f=require('fs');f.copyFileSync('dist/sentinel-auth.js','../sentinel-auth.js');f.copyFileSync('dist-app/sentinel-app.js','../sentinel-app.js');f.copyFileSync('dist-ops/sentinel-ops.js','../sentinel-ops.js')\""
  },
  "dependencies": {
    "@privy-io/react-auth": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0"
  }
}
