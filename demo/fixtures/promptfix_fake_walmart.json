ess listed\n</footer>\n\n<script>\n  // fake countdown that never really ends (resets each load)\n  let s = 599; const tick = () => { s--; if (s < 0) s = 599; const m = String(Math.floor(s/60)).padStart(2,'0'), c = String(s%60).padStart(2,'0'); document.getElementById('t').textContent = document.getElementById('t2').textContent = m + ':' + c; }; setInterval(tick, 1000);\n</script>\n</body>\n</html>\n",
